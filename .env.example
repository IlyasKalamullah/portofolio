# === Supabase Database (Project Settings > Database > Connection string) ===
# Transaction pooler (port 6543) — dipakai aplikasi di Vercel
DATABASE_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"
# Session pooler / direct (port 5432) — dipakai Prisma untuk membuat tabel
DIRECT_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# === Supabase Storage (Project Settings > API) — untuk upload gambar ===
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ..."
SUPABASE_BUCKET="portfolio"

# === Login Admin ===
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ganti-dengan-password-kuat"
# String acak panjang (min 32 karakter). Buat dengan: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-string-acak-panjang-minimal-32-karakter"

# === (Opsional) Terjemahan CV ke bahasa Inggris dengan Gemini AI — hasil lebih natural ===
# Tanpa ini, CV memakai Google Translate gratis. Buat key gratis di https://aistudio.google.com/apikey
GEMINI_API_KEY=""
